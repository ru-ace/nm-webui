[Unit]
Description=NetworkManager Web UI
Documentation=https://github.com/ru-ace/nm-webui
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/nm-webui --config /etc/nm-webui/config.yaml
Restart=always
RestartSec=5
User=root
# For non-root, add user to 'netdev' group and set:
# User=nm-webui
# Group=netdev
# AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
# CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
# With the Power section enabled (power-action-password) on a non-root
# service user, also install deploy/sudoers/nm-webui-power and set
# NoNewPrivileges=false below (see the note there). deploy/install.sh
# does both automatically.

# Security hardening
# NoNewPrivileges prevents the setuid sudo binary from gaining privileges,
# which breaks the Power section's non-root shutdown path. When running as
# root (the default) it can stay enabled.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nm-webui /run/nm-webui
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target